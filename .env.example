NODE_ENV=development
PORT=3000
APP_NAME=HanoFlow

# Local development only. Change the password and match its URL-encoded value below.
POSTGRES_DB=hanoflow
POSTGRES_USER=hanoflow
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5434
DATABASE_URL=postgresql://hanoflow:change-me-local-only@127.0.0.1:5434/hanoflow?schema=public
# Integration tests must target a dedicated disposable database, never production.
TEST_DATABASE_URL=postgresql://hanoflow:change-me-local-only@127.0.0.1:5434/hanoflow_test?schema=public

# Dedicated Redis; 6381 is reserved for future isolated tests.
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380/0
QUEUE_PREFIX=hanoflow-dev
# Real Redis tests use separate .env.redis-test (npm run redis:test:up).
# Never point TEST_REDIS_URL at this development Redis instance.
