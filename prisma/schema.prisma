generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum AuditScope {
  PLATFORM
  TENANT
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

// Reviewed SQL adds email normalization checks and canonicalEmail COLLATE "C".
model User {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String              @db.VarChar(254)
  canonicalEmail     String              @unique @db.VarChar(254)
  status             UserStatus          @default(PENDING)
  emailVerifiedAt    DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @default(now()) @updatedAt @db.Timestamptz(3)
  memberships        Membership[]
  auditEvents        AuditEvent[]
  passwordCredential PasswordCredential?
  sessions           Session[]
  roleGrants         MembershipRole[]    @relation("RoleGrantActor")
  roleRemovals       MembershipRole[]    @relation("RoleRemovalActor")
}

enum SessionScope {
  IDENTITY
  TENANT
}

enum SessionClient {
  BROWSER
  MOBILE
}

enum SessionRevocationReason {
  EXPLICIT
  REVOKE_ALL
  REFRESH_REPLAY
}

// Tenant context/elevation intentionally deferred; contextVersion permits future invalidation.
model Session {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                   @db.Uuid
  scope             SessionScope             @default(IDENTITY)
  client            SessionClient
  contextVersion    Int                      @default(1)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  lastActivityAt    DateTime                 @db.Timestamptz(3)
  idleExpiresAt     DateTime                 @db.Timestamptz(3)
  absoluteExpiresAt DateTime                 @db.Timestamptz(3)
  revokedAt         DateTime?                @db.Timestamptz(3)
  revocationReason  SessionRevocationReason?
  user              User                     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accessTokens      AccessToken[]
  refreshTokens     RefreshToken[]
  tenantId          String?                  @db.Uuid
  membershipId      String?                  @db.Uuid
  tenant            Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership        Membership?              @relation(fields: [tenantId, membershipId, userId], references: [tenantId, id, userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt, id])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
  @@index([tenantId, membershipId])
}

model AccessToken {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId      String   @db.Uuid
  digest         Bytes    @unique @db.ByteA
  contextVersion Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime @db.Timestamptz(3)
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([sessionId])
  @@index([expiresAt])
}

// SQL adds one-unconsumed-token partial unique index and lineage/timestamp CHECKs.
model RefreshToken {
  contextVersion Int            @default(1)
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId      String         @db.Uuid
  digest         Bytes          @unique @db.ByteA
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime       @db.Timestamptz(3)
  consumedAt     DateTime?      @db.Timestamptz(3)
  predecessorId  String?        @unique @db.Uuid
  session        Session        @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  predecessor    RefreshToken?  @relation("Rotation", fields: [sessionId, predecessorId], references: [sessionId, id], onDelete: Restrict, onUpdate: Restrict)
  successor      RefreshToken[] @relation("Rotation")

  @@unique([sessionId, id])
  @@index([expiresAt])
}

// Shared primary key enforces zero-or-one credential per global user.
// Rehash changes passwordHash/updatedAt, never passwordChangedAt.
model PasswordCredential {
  userId            String   @id @db.Uuid
  passwordHash      String   @db.VarChar(512)
  passwordChangedAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

// Reviewed SQL adds nonblank name and normalized slug checks.
model Tenant {
  roles       Role[]
  sessions    Session[]
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String       @db.VarChar(200)
  slug        String       @unique @db.VarChar(100)
  status      TenantStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  memberships Membership[]
  auditEvents AuditEvent[]
}

// joinedAt is the first join; future reactivation reuses this row.
// Reviewed SQL enforces removedAt/status consistency and removal chronology.
model Membership {
  roles     MembershipRole[]
  sessions  Session[]
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @db.Uuid
  tenantId  String           @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now()) @db.Timestamptz(3)
  removedAt DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@unique([tenantId, id, userId])
  @@index([userId, status])
  @@index([tenantId, status, id])
}

enum RoleTemplate {
  OWNER
  ADMIN
  DISPATCHER
  WAREHOUSE_OPERATOR
  FINANCE_OFFICER
  COURIER
  MERCHANT
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum PermissionScope {
  TENANT
}

model Role {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String           @db.Uuid
  code            RoleTemplate
  name            String           @db.VarChar(80)
  templateVersion Int              @default(1)
  status          RoleStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  memberships     MembershipRole[]
  permissions     RolePermission[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
}

model Permission {
  code        String           @id @db.VarChar(80)
  scope       PermissionScope  @default(TENANT)
  description String           @db.VarChar(200)
  roles       RolePermission[]

  @@unique([code, scope])
}

model MembershipRole {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String     @db.Uuid
  membershipId    String     @db.Uuid
  roleId          String     @db.Uuid
  grantedAt       DateTime   @default(now()) @db.Timestamptz(3)
  grantedByUserId String?    @db.Uuid
  removedAt       DateTime?  @db.Timestamptz(3)
  removedByUserId String?    @db.Uuid
  membership      Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  role            Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  grantingActor   User?      @relation("RoleGrantActor", fields: [grantedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  removingActor   User?      @relation("RoleRemovalActor", fields: [removedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, membershipId, removedAt])
  @@index([tenantId, roleId, removedAt])
  @@index([grantedByUserId])
  @@index([removedByUserId])
}

model RolePermission {
  tenantId       String          @db.Uuid
  roleId         String          @db.Uuid
  permissionCode String          @db.VarChar(80)
  scope          PermissionScope @default(TENANT)
  role           Role            @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  permission     Permission      @relation(fields: [permissionCode, scope], references: [code, scope], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, roleId, permissionCode])
  @@index([permissionCode, scope])
}

// NULL actor represents a system event, independently of PLATFORM/TENANT scope.
// SQL checks enforce scope, bounded object metadata and nonblank identifiers.
// No updatedAt; append-only permissions and metadata allowlists are future work.
model AuditEvent {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId   String?      @db.Uuid
  tenantId      String?      @db.Uuid
  scope         AuditScope
  action        String       @db.VarChar(100)
  targetType    String       @db.VarChar(80)
  targetId      String?      @db.VarChar(128)
  outcome       AuditOutcome
  correlationId String       @db.Uuid
  metadata      Json?        @db.JsonB
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  actor         User?        @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tenant        Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, createdAt, id])
  @@index([actorUserId, createdAt, id])
  @@index([correlationId])
}
