{
  "name": "hanoflow-backend",
  "version": "0.1.0",
  "description": "HanoLink delivery management backend foundation",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "^24.15.0",
    "npm": ">=10.9"
  },
  "scripts": {
    "benchmark:passwords": "node scripts/benchmark-passwords.mjs",
    "redis:test:up": "node scripts/redis-test.mjs up",
    "redis:test:inspect": "node scripts/redis-test.mjs inspect",
    "redis:test:stop": "node scripts/redis-test.mjs stop",
    "test:redis": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.redis.config.mjs --runInBand --detectOpenHandles",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio --browser none",
    "test:db": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.database.config.mjs --runInBand",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint src test prisma.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:cov": "npm test -- --coverage",
    "test:e2e": "npm test -- --selectProjects e2e"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.1"
    }
  },
  "dependencies": {
    "@apollo/server": "5.5.2",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "14.2.1",
    "@nestjs/bullmq": "12.0.2",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/graphql": "14.2.1",
    "@nestjs/platform-express": "^12.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "bullmq": "6.7.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "graphql": "16.15.0",
    "ioredis": "6.1.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "^12.6.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.0.0",
    "prettier": "^3.0.0",
    "prisma": "7.10.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.74.0"
  }
}
